# Required for the default zero-cost inference path
GROQ_API_KEY=

# Optional zero-cost fallback. Uses OpenRouter's free router.
OPENROUTER_API_KEY=

# Optional: only enable after checking your Gemini project is on a free tier.
GEMINI_API_KEY=
ENABLE_GEMINI_FALLBACK=0

# Neon/Postgres. Leave empty for local SQLite development.
DATABASE_URL=

# Runtime
LOOKBACK_HOURS=72
MAX_EDITOR_CANDIDATES=10
MAX_FINAL_ITEMS=8
MIN_DISCOVERY_SUCCESSES=6
MIN_DISCOVERED_SOURCES=25
TZ=Europe/Bucharest
SCOUT_CALL_DELAY_SECONDS=8

# Optional email delivery (e.g. Gmail SMTP + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
